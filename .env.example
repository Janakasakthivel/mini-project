# HeatShield India Environment Configuration Example

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=heatshield-secure-secret-key-change-in-production-2026

# Optional: OpenWeatherMap API Key (If omitted, system uses Open-Meteo High-Resolution Numerical API with zero key required)
# OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Node Environment
NODE_ENV=production
